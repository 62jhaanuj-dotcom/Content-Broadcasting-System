    {
      "name": "01 Auth",
      "item": [
        {
          "name": "01 Signup Teacher",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const teacherEmail = pm.variables.replaceIn('teacher1_{{$timestamp}}@mail.com');",
                  "const teacherPassword = pm.collectionVariables.get('teacherPassword');",
                  "if (typeof teacherPassword !== 'string' || teacherPassword.trim().length < 6) {",
                  "  throw new Error('teacherPassword must be at least 6 characters and cannot be blank or spaces-only.');",
                  "}",
                  "pm.collectionVariables.set('teacherEmail', teacherEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Teacher signup succeeded', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.user) {",
                  "  pm.collectionVariables.set('teacherId', data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teacher One\",\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\",\n  \"role\": \"teacher\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Creates a teacher user with a unique email and saves the returned teacher ID. Required fields: name, email, password, role. Password must be at least 6 characters and cannot be blank or spaces-only."
          },
          "response": []
        },
